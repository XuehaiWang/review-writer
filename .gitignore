/*
!/.gitignore
!/.dockerignore
!/.github/
!/.github/**
!/README.md
!/requirements.txt
!/pyproject.toml
!/alembic.ini
!/Dockerfile.api
!/Dockerfile.pdf-renderer
!/compose.yaml
!/review_writer_api/
!/review_writer_api/**
!/skills/
!/skills/**
!/view/
!/view/**
!/review-library/
!/review-library/.gitkeep
/review-library/**
!/review-library/.gitkeep
!/examples/
!/examples/**
!/review_writer_core/
!/review_writer_core/**
!/review_writer_pdf_renderer/
!/review_writer_pdf_renderer/**
!/migrations/
!/migrations/**
!/docs/
!/docs/**
!/tests/
!/tests/**
!/frontend/
!/frontend/**

/.env
/.env.*
!/.env.hosted.example

/skills/**/__pycache__/
/view/**/__pycache__/
/skills/review-export-docx/.deps/
/skills/mineru-precise-parse-review-writer/config/mineru_api_token.txt

# Generated test caches are not part of the release package. Test source files
# remain trackable so portability and workflow regressions ship with the code.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/*.log
**/*.pid
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.db-journal
**/*.db-shm
**/*.db-wal
**/.deps/
**/.vite/
**/coverage/

# Local Codex/agent execution records and planning artifacts.
/.agents/
/.codex/
/.codex-qa/
/.codex-tmp/
/.superpowers/
/docs/superpowers/
/output/
/outputs/
/tmp/
/review_writer.egg-info/
/frontend/node_modules/
/frontend/dist/
/frontend/*.tsbuildinfo
