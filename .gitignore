/*
!/.gitignore
!/.dockerignore
!/.github/
!/.github/**
!/README.md
!/requirements.txt
!/pyproject.toml
!/alembic.ini
!/Dockerfile.api
!/compose.yaml
!/review_writer_api/
!/review_writer_api/**
!/skills/
!/skills/**
!/view/
!/view/**
!/review-library/
!/review-library/.gitkeep
/review-library/**
!/review-library/.gitkeep
!/examples/
!/examples/**
!/review_writer_core/
!/review_writer_core/**
!/migrations/
!/migrations/**
!/infra/
!/infra/**
!/docs/
!/docs/**
!/tests/
!/tests/**

/.env
/.env.*
!/.env.hosted.example

/skills/**/__pycache__/
/view/**/__pycache__/
/skills/review-export-docx/.deps/
/skills/mineru-precise-parse-review-writer/config/mineru_api_token.txt

# Generated test caches are not part of the release package. Test source files
# remain trackable so portability and workflow regressions ship with the code.
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage

# Local Codex/agent execution records and planning artifacts.
/.agents/
/.codex/
/.superpowers/
/docs/superpowers/
