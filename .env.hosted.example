# Copy to .env.hosted and start Compose with --env-file .env.hosted.
# Keeping this separate avoids overwriting the local single-user .env file.
REVIEW_WRITER_IMAGE_TAG=latest
REVIEW_WRITER_POSTGRES_PASSWORD=replace-with-a-long-random-password
REVIEW_WRITER_POSTGRES_USER=review_writer
REVIEW_WRITER_POSTGRES_DB=review_writer
REVIEW_WRITER_POSTGRES_BIND_ADDRESS=127.0.0.1
REVIEW_WRITER_POSTGRES_BIND_PORT=5432

# Persistent host directories for automatic one-time SQLite migration evidence.
REVIEW_WRITER_MIGRATION_REPORTS_DIR=./migration-reports
REVIEW_WRITER_MIGRATION_BACKUPS_DIR=./migration-backups
# Required only when migrating a legacy single-user database instead of hosted user folders.
# REVIEW_WRITER_MIGRATION_OWNER_EMAIL=owner@example.com
# Keep false until every reported missing file has been investigated and consciously accepted.
REVIEW_WRITER_MIGRATION_ACCEPT_MISSING_FILES=false
# Separate acknowledgement for files changed in place after their legacy SHA-256 was recorded.
REVIEW_WRITER_MIGRATION_ACCEPT_FILE_DRIFT=false

# Public URL used by the browser. Replace with the real HTTPS origin in production.
REVIEW_WRITER_PUBLIC_ORIGIN=http://127.0.0.1:8770
# Keep loopback for same-machine use. Use 0.0.0.0 only behind a firewall/reverse proxy
# or when deliberately exposing the app to a trusted LAN.
REVIEW_WRITER_BIND_ADDRESS=127.0.0.1
REVIEW_WRITER_HTTP_PORT=8770
REVIEW_WRITER_SESSION_COOKIE_SECURE=false
REVIEW_WRITER_SESSION_DAYS=7
REVIEW_WRITER_SESSION_COOKIE_NAME=review_writer_session
# Comma-separated accounts allowed to open /admin. An existing matching user
# is promoted on the next successful login.
REVIEW_WRITER_ADMIN_EMAILS=owner@example.com

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
REVIEW_WRITER_CREDENTIAL_ENCRYPTION_KEY=replace-with-32-random-bytes-as-base64url
REVIEW_WRITER_EXPOSE_API_DOCS=false
REVIEW_WRITER_JOB_WORKERS=2

# Server-owned provider credentials. Users choose only Sol, Terra, or Luna.
# Text/image keys stay in the API gateway; the MinerU token is exposed only to
# the isolated precise-parser process and is redacted from commands and logs.
REVIEW_WRITER_OPENAI_API_KEY=replace-with-server-api-key
REVIEW_WRITER_OPENAI_BASE_URL=https://api.openai.com/v1
REVIEW_WRITER_OPENAI_WIRE_API=responses
# Leave blank to reuse REVIEW_WRITER_OPENAI_API_KEY for image calls.
REVIEW_WRITER_IMAGE_API_KEY=
REVIEW_WRITER_IMAGE_BASE_URL=https://api.openai.com/v1
REVIEW_WRITER_IMAGE_MODEL=gpt-image2.0
REVIEW_WRITER_IMAGE_WIRE_API=images
REVIEW_WRITER_IMAGE_USD_PER_IMAGE=0
REVIEW_WRITER_IMAGE_GATEWAY_CONCURRENCY=1
REVIEW_WRITER_IMAGE_GATEWAY_USER_CONCURRENCY=1
REVIEW_WRITER_MINERU_API_TOKEN=replace-with-server-mineru-token
REVIEW_WRITER_MINERU_USD_PER_PAGE=0
REVIEW_WRITER_MINERU_CONCURRENCY=2
# Scientific subprocesses call this loopback route with a short-lived task token.
REVIEW_WRITER_INTERNAL_GATEWAY_URL=http://127.0.0.1:8770/api/internal/v1/model-responses
REVIEW_WRITER_MODEL_GATEWAY_CONCURRENCY=2
REVIEW_WRITER_MODEL_GATEWAY_USER_CONCURRENCY=1

REVIEW_WRITER_AUTH_RATE_LIMIT_ATTEMPTS=12
REVIEW_WRITER_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# Keep false for public deployments. Enable only when model endpoints are on a trusted LAN.
REVIEW_WRITER_ALLOW_PRIVATE_PROVIDER_URLS=false
# Exact public provider hostnames permitted by the scientific-task egress guard.
REVIEW_WRITER_ALLOWED_PROVIDER_HOSTS=api.openai.com,mineru.net,www.micuapi.ai
# Optional transparent-proxy fake-IP ranges. These defaults support Docker
# Desktop networking while real LAN/private ranges remain blocked.
REVIEW_WRITER_TRUSTED_PROXY_NETWORKS=198.18.0.0/15,fdfe:dcba:9876::/48

# Optional server-wide SciAtlas integration. Prefer an HTTPS endpoint or local proxy.
# SCIATLAS_API_BASE_URL=https://sciatlas-proxy.example
# SCIATLAS_API_KEY=replace-with-sciatlas-api-key
# SCIATLAS_TIMEOUT=240
# SCIATLAS_ALLOW_INSECURE_HTTP=false

# Compose stores user workspaces in its persistent review_state volume. Only set this
# when running the API outside Docker.
# REVIEW_WRITER_HOSTED_WORKSPACE_ROOT=/srv/review-writer/users
